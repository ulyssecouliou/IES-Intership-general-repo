{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sia4010.authority_decision.v1",
  "title": "Normalized written SIA authority decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "primary_source_sha256",
    "source_locator",
    "decision_id",
    "issued_by",
    "issued_date",
    "document_reference",
    "question",
    "decision",
    "applicable_cases",
    "resolved_parameters"
  ],
  "properties": {
    "schema_id": {"const": "sia4010.authority_decision.v1"},
    "schema_version": {"const": "1.0"},
    "primary_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_locator": {"type": "string", "minLength": 1},
    "decision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "issued_by": {"type": "string", "minLength": 1},
    "issued_date": {"type": "string", "minLength": 1},
    "document_reference": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "minLength": 1},
    "applicable_cases": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "resolved_parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value", "unit", "source_locator"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "value": {},
          "unit": {"type": "string", "minLength": 1},
          "source_locator": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
