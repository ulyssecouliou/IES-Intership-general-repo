[flake8]
max-line-length = 90
# Black deliberately leaves long strings/comments untouched, so E501 must not
# duplicate the formatter. W503 and E203 are likewise incompatible with Black.
extend-ignore = E203,E501,W503
exclude =
    .git,
    __pycache__,
    .pytest_cache,
    .mypy_cache,
    .codex_tmp,
    .codex_test_runs,
    .test-tmp*,
    tmp*,
    outputs,
    reports,
    tests/_pytest_full_release_20260824
per-file-ignores =
    scripts/legacy/*:E501
    scripts/reference_model_dry_run.py:E402
    swiss_sia/app.py:E402
